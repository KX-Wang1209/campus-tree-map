# ============================================================
#  不上传到 GitHub 的内容
# ============================================================

# 打包产物（49M）。用 sh launcher/build.sh 可以随时重新生成
/dist/

# launcher/web 是构建时自动从 web/ 复制过去的副本，源文件在 web/
/launcher/web/

# Wisp 应用自己的项目数据（含数据库，67M）
/.wisp/

# 运行时产生的学生记录和照片（每台电脑各存各的）
/data/live/

# macOS 系统文件
.DS_Store
._*

# 编辑器
.vscode/
.idea/
*.swp

# Python 缓存
__pycache__/
*.pyc

# 用户上传的原始文件（已归档到 data/raw/）
/uploads/

# 浏览器截图（视觉工具产物）
browser-assets/
